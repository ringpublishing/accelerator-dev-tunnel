{
    "name": "@ringpublishing/accelerator-dev-tunnel",
    "description": "Receive real Ring Accelerator traffic on your local machine via dev-tunnel variants",
    "license": "MIT",
    "homepage": "https://developer.ringpublishing.com/docs/Accelerator/topics/development/dev-tunnel/index.html",
    "main": "dist/index.cjs",
    "type": "module",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ringpublishing/accelerator-dev-tunnel.git"
    },
    "bin": {
        "acc-dev-tunnel": "dist/cli/index.js"
    },
    "engines": {
        "node": "^20||^22||^24"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./vite": {
            "import": {
                "types": "./dist/plugins/vite.d.ts",
                "default": "./dist/plugins/vite.js"
            },
            "require": {
                "types": "./dist/plugins/vite.d.cts",
                "default": "./dist/plugins/vite.cjs"
            }
        },
        "./webpack": {
            "import": {
                "types": "./dist/plugins/webpack.d.ts",
                "default": "./dist/plugins/webpack.js"
            },
            "require": {
                "types": "./dist/plugins/webpack.d.cts",
                "default": "./dist/plugins/webpack.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc && tsup",
        "lint": "npm run lint:js",
        "lint:js": "eslint --ext .js,.jsx,.ts,.tsx src/ tests/ *.ts",
        "lint:js:fix": "npm run lint:js -- --fix",
        "prepare": "npm run build",
        "test": "vitest run --coverage",
        "test:e2e": "vitest run -c vitest.e2e.config.ts",
        "test:watch": "vitest"
    },
    "dependencies": {
        "ws": "^8.0.0"
    },
    "devDependencies": {
        "@ringieraxelspringer/eslint-config": "^24.0.0",
        "@ringieraxelspringer/tsconfig": "^7.0.0",
        "@types/node": "^24.0.0",
        "@types/ws": "^8.0.0",
        "@vitest/coverage-v8": "^5.0.0",
        "html-webpack-plugin": "^5.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.0",
        "webpack": "^5.0.0",
        "webpack-dev-server": "^6.0.0"
    },
    "peerDependencies": {
        "vite": "^5||^6||^7||^8",
        "webpack": "^5"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        },
        "webpack": {
            "optional": true
        }
    },
    "eslintConfig": {
        "extends": "@ringieraxelspringer/eslint-config"
    }
}
